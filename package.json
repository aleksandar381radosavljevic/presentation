{
  "name": "presentation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build && vite build --ssr src/entry-server.ts --outDir dist-ssr && node scripts/prerender.ts",
    "type-check": "vue-tsc --build --force",
    "tokens": "node scripts/build-tokens.ts && prettier --write src/shared/ui/styles/tokens.css",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "prepare": "husky"
  },
  "dependencies": {
    "@lucide/vue": "^1.52.0",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "husky": "^9.1.7",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": ">=22.18"
  }
}
